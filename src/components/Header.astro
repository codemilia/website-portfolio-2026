---
import "../styles/header.css";
import headerLogo from "../assets/logos/alien-logo-primary-small.svg";


const { minimal = false } = Astro.props;

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + "/";

const links = [
  { label: "Home", href: base },
  { label: "Portfolio", href: `${base}portfolio` },
  { label: "Kontakt", href: `${base}contact` },
];


const currentPath = Astro.url.pathname.replace(/\/$/, '');

const isCurrent = (href: string) => {
  const target = href.replace(/\/$/, '');
  return currentPath === target;
};


---

<header class:list={["site-header", { "site-header--minimal": minimal }]}>
  <a class="site-header__logo" href={base} aria-label="Home">
    <img src={headerLogo.src} alt="Your Business" height="60" />
  </a>

  <button
    class="site-header__toggle"
    type="button"
    aria-label="Menü öffnen"
    aria-expanded="false"
    aria-controls="main-nav"
  >
    <span class="site-header__bar"></span>
    <span class="site-header__bar"></span>
  </button>

  <nav id="main-nav" class="site-header__nav" aria-label="Main">
    <ul>
      {links.map((link, i) => (
        <li style={`--i: ${i}`}>
          <a 
            class="site-header__link" 
            href={link.href}
            aria-current={isCurrent(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(
    ".site-header__toggle",
  );
  const nav = document.querySelector<HTMLElement>(".site-header__nav");

  function setOpen(open: boolean) {
    nav?.classList.toggle("open", open);
    toggle?.setAttribute("aria-expanded", String(open));
    toggle?.setAttribute("aria-label", open ? "Menü schließen" : "Menü öffnen");
  }

  toggle?.addEventListener("click", () => {
    setOpen(toggle.getAttribute("aria-expanded") !== "true");
  });

  // Close the menu with Escape
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setOpen(false);
  });

  // Close the menu when clicking outside of it
  document.addEventListener("click", (e) => {
    const target = e.target as Node;
    if (!nav?.contains(target) && !toggle?.contains(target)) {
      setOpen(false);
    }
  });
</script>
